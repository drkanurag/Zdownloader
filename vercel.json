{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "excludeFiles": "{bin/**,public/**,static/**,docs/**,tests/**,*.zip,*.bat}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py/status"
    },
    {
      "source": "/health(.*)",
      "destination": "/api/index.py/health$1"
    },
    {
      "source": "/ready(.*)",
      "destination": "/api/index.py/ready$1"
    }
  ]
}
